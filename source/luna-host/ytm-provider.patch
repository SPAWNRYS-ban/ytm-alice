+++ b/tests/yam_service.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Exercise the BusyBox service helper with an empty runtime directory."""
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import urllib.request
+
+binary = Path(sys.argv[1]).resolve()
+with tempfile.TemporaryDirectory(prefix="luna-service-") as temporary:
+    root = Path(temporary)
+    yam = root / "yam"
+    (yam / "bin").mkdir(parents=True)
+    (yam / "bin/luna").symlink_to(binary)
+    helper = yam / "bin/luna-service"
+    shutil.copy2(Path(__file__).resolve().parents[1] / "tools/luna-service", helper)
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        port = sock.getsockname()[1]
+    run = root / "service-run"
+    run.mkdir()
+    # An old pidfile must never make the helper signal an unrelated process.
+    other = subprocess.Popen(["sleep", "60"])
+    (run / "pid").write_text(str(other.pid))
+    env = dict(os.environ, YAM_ROOT=str(yam), YAM_RUN=str(root / "new-yam-run"),
+               LUNA_RUN=str(run), LUNA_LISTEN=f"127.0.0.1:{port}")
+
+    def service(action, check=True):
+        result = subprocess.run([str(helper), action], env=env, check=False,
+                                capture_output=True, text=True, timeout=30)
+        if check and result.returncode:
+            raise AssertionError(f"{action} failed: {result.stdout}{result.stderr}")
+        return result
+
+    try:
+        assert service("status", check=False).returncode != 0
+        service("start")
+        service("status")
+        assert (root / "new-yam-run/yam.lock").exists()
+        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/settings", timeout=3) as reply:
+            assert not json.load(reply)["updates"]["enabled"]
+        before = (run / "pid").read_text()
+        service("start")
+        assert before == (run / "pid").read_text(), "duplicate daemon"
+        service("stop")
+        assert service("status", check=False).returncode != 0
+        lock = root / "new-yam-run/yam.lock"
+        lock.write_bytes(b"existing-lock")
+        service("start")
+        assert lock.read_bytes() == b"existing-lock", "existing lock was truncated"
+        service("stop")
+        assert other.poll() is None, "stale pidfile killed an unrelated process"
+        print("PASS: fresh boot directory, readiness, idempotent start, stop, stale PID safety")
+    finally:
+        service("stop", check=False)
+        other.terminate()
+        other.wait(timeout=3)
diff --git a/tools/luna-service b/tools/luna-service
new file mode 100755
index 0000000..3e8e256
--- /dev/null
+++ b/tools/luna-service
@@ -0,0 +1,68 @@
+#!/bin/sh
+# Luna lifecycle for YAM installations on BusyBox init.
+set -eu
+ROOT=${YAM_ROOT:-/data/yam}
+STATE=$ROOT/var/yam.luna
+RUN=${LUNA_RUN:-/tmp/luna}
+YAM_RUN=${YAM_RUN:-/tmp/yam}
+LUNA_LISTEN=${LUNA_LISTEN:-127.0.0.1:8099}
+HOOK=/etc/init.d/S99zluna
+umask 077
+mkdir -p "$RUN" "$STATE" "$YAM_RUN"
+alive() {
+    [ -f "$RUN/pid" ] || return 1
+    pid=$(cat "$RUN/pid")
+    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
+    kill -0 "$pid" 2>/dev/null || return 1
+    [ "$(readlink "/proc/$pid/exe")" = "$(readlink -f "$ROOT/bin/luna")" ]
+}
+case "${1:-status}" in
+    run)
+        export YAM_ROOT="$ROOT" YAM_VAR="$ROOT/var"
+        exec "$ROOT/bin/luna" --data-dir "$STATE" --yam-root "$ROOT" --yam-run "$YAM_RUN" --listen "$LUNA_LISTEN"
+        ;;
+    start)
+        alive && exit 0
+        rm -f "$RUN/pid"
+        nohup "$0" run >"$RUN/runtime.log" 2>&1 </dev/null &
+        echo "$!" >"$RUN/pid"
+        sleep 1
+        alive || { cat "$RUN/runtime.log" >&2; rm -f "$RUN/pid"; exit 1; }
+        ;;
+    stop)
+        if alive; then
+            kill "$pid"
+            count=0
+            while alive; do
+                count=$((count+1))
+                [ "$count" -lt 24 ] || { echo 'Luna has not finished package cleanup' >&2; exit 1; }
+                sleep 1
+            done
+        fi
+        rm -f "$RUN/pid"
+        ;;
+    restart) "$0" stop; "$0" start ;;
+    status) alive && echo "Luna running (PID $pid)" ;;
+    install|uninstall)
+        action=$1
+        if [ -f "$HOOK" ] && ! grep -q '^# Managed by Luna YAM service$' "$HOOK"; then
+            echo "Refusing unmanaged $HOOK" >&2; exit 1
+        fi
+        mount -o remount,rw /
+        trap 'mount -o remount,ro /' EXIT
+        if [ "$action" = uninstall ]; then
+            "$0" stop
+            rm -f "$HOOK"
+        else
+            cat >"$HOOK" <<'EOF'
+#!/bin/sh
+# Managed by Luna YAM service
+export YAM_ROOT=/data/yam
+[ -x "$YAM_ROOT/bin/luna-service" ] || exit 0
+exec "$YAM_ROOT/bin/luna-service" "${1:-start}"
+EOF
+            chmod 755 "$HOOK"
+        fi
+        ;;
+    *) echo 'luna-service install|uninstall|start|stop|restart|status|run' >&2; exit 2 ;;
+esac
